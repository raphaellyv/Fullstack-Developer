<table class="table table-striped mt-4 table align-middle">
    <thead class="table-light">
      <tr>
        <th scope="col"></th>
        <th scope="col"><%= User.model_name.human.capitalize %></th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td class="text-end"><%= image_tag user.avatar_image, class: "img-thumbnail", alt: "avatar", style: "max-height: 90px;" %></td>
          <td>
            <p class="fs-6"><%= user.full_name %></p>
            <p class="text-body-secondary fs-6"><%= user.email %></p>
          </td>
          <td><%= render "edit_user_modal", user: user %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  