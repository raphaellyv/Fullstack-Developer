<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <%= link_to t("app_name"), root_path, class: "navbar-brand" %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavDropdown">
      <% if current_user %>
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <%= link_to t("user.profile.title"), profile_path, class: "nav-link #{ 'active' if current_page?(profile_path) }" %>
          </li>

          <% if current_user.admin? %>
            <%= link_to t("user.admin.dashboard.link"), dashboard_path, class: "nav-link #{ 'active' if current_page?(dashboard_path) }" %>
          <% end %>
        </ul>
        <%= button_to t("devise.sign_out.link"), destroy_user_session_path, method: :delete, class: "btn btn-outline-secondary me-2" %>
      <% else %>
        <div class="navbar-nav me-auto mb-2 mb-lg-0"></div>
        <%= link_to t("devise.sign_in.link"), new_user_session_path, class: "btn btn-outline-primary me-2" %>
      <% end %>
    </div>
  </div>
</nav>