<div class="d-flex flex-column align-items-center mt-5">
  <h2><%= t('user.edit.title') %></h2>
  
  <%= form_for(@user, url: admin_path(@user), method: :patch) do |f| %>
    <%= render "devise/shared/error_messages", resource: @user %>

    <div class="d-grid gap-3 mb-3">
      <% if @user.avatar_image.variant(:medium) %>
        <div class="text-center">
          <%= image_tag @user.avatar_image.variant(:medium), class: "img-thumbnail rounded-circle", alt: "avatar", style: "max-height: 150px;" %>
        </div>
      <% end %>

      <div>
        <%= f.label :full_name, class: "form-lable" %>
        <%= f.text_field :full_name, autofocus: true, autocomplete: "full-name", class: "form-control", required: true %>
      </div>

      <div>
        <%= f.label :email, class: "form-lable" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", required: true %>
      </div>

      <div>
        <%= f.label :avatar_image, class: "form-lable" %>
        <%= f.file_field :avatar_image, class: "form-control" %>
      </div>

      <div>
        <%= f.label :role, class: "form-lable" %>
        <%= f.select :role, @roles_options.map { |w| [User.human_attribute_name("role.#{w}"), w] }, {}, { class: "form-select" } %>
      </div>

      <div>
        <%= f.submit t("user.edit.submit_button"), class: "btn btn-primary w-100" %>
      </div>

      <%= link_to t("user.edit.cancel_button"), admin_dashboard_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
  <br>
  <div class="d-grid gap-3 mb-3"> 
    <h3><%= t("user.admin.remove_user.title") %></h3>
    <%= button_to t("user.admin.remove_user.button"), admin_path(@user.id), method: :delete, class: "btn btn-danger w-100", form: { data: { turbo_confirm: t("messages.turbo_confirm") } } %>
  </div>
</div>
