<%= form_with url: import_admin_index_path, method: :post do |f| %>
  <div class="container">
    <%= f.file_field :file, accept: ".csv", class: "form-control" %>

    <div class="btn-group">
      <%= f.submit t("user.admin.dashboard.import_button"), class: "btn btn-primary" %>
    </div>
  </div>
<% end %>