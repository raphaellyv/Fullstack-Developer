<table class="table table-striped table-bordered mt-4 text-center">
    <thead class="table-light">
      <tr>
        <th scope="col"><%= User.human_attribute_name(:avatar_image) %></th>
        <th scope="col"><%= User.human_attribute_name(:full_name) %></th>
        <th scope="col"><%= User.human_attribute_name(:email) %></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= image_tag user.avatar_image, class: "img-thumbnail", alt: "avatar", style: "max-height: 90px;" %></td>
          <td><%= user.full_name %></td>
          <td><%= user.email %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  