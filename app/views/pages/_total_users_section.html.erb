<div class="row">
    <div class="col-sm-4 mb-3 mb-sm-0">
      <div class="card">
        <div class="card-body text-center">
          <h5 class="card-title"><%= @total_users %></h5>
          <p class="card-text"><%= t("user", count: @total_users) %></p>
        </div>
      </div>
    </div>
    <div class="col-sm-4 mb-3 mb-sm-0">
      <div class="card">
        <div class="card-body text-center">
          <h5 class="card-title"><%= @total_no_admins %></h5>
          <p class="card-text"><%= t("user.regular_user", count: @total_no_admins) %></p>
        </div>
      </div>
    </div>
    <div class="col-sm-4">
      <div class="card">
        <div class="card-body text-center">
          <h5 class="card-title"><%= @total_admins %></h5>
          <p class="card-text"><%= t("user.admin", count: @total_admins) %></p>
        </div>
      </div>
    </div>
  </div>
  