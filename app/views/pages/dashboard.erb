<div class="position-relative">
  <ul class="list-group list-group-horizontal-lg mt-3">
    <li class="list-group-item">Number of users: <%= @total_users %></li>
    <li class="list-group-item">Number of regular users: <%= @total_no_admins %></li>
    <li class="list-group-item">Number of administrators: <%= @total_admins %></li>
  </ul>

  <table class="table table-striped table-bordered mt-3 text-center">
    <thead class="table-light">
      <tr>
        <th scope="col"></th>
        <th scope="col"><%= User.human_attribute_name(:full_name) %></th>
        <th scope="col"><%= User.human_attribute_name(:email) %></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= image_tag user.avatar_image, class: "img-thumbnail", alt: "avatar", style: "max-height: 90px;" %></td>
          <td><%= user.full_name %></td>
          <td><%= user.email %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
