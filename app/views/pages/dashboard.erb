<table class="table mt-3">
  <thead>
    <tr>
      <th scope="col"></th>
      <th scope="col"><%= User.human_attribute_name(:full_name) %></th>
      <th scope="col"><%= User.human_attribute_name(:email) %></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td class="text-center"><%= image_tag user.avatar_image, class: "img-thumbnail", alt: "avatar", style: "max-height: 90px;" %></td>
        <td><%= user.full_name %></td>
        <td><%= user.email %></td>
      </tr>
    <% end %>
  </tbody>
</table>
